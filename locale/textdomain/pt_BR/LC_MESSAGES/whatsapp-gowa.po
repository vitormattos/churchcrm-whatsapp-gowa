msgid "Admin-only WhatsApp sending and session pairing via Go WhatsApp."
msgstr "Envio administrativo de mensagens pelo WhatsApp e pareamento de dispositivos via Go WhatsApp."

msgid "Allow message sending"
msgstr "Permitir envio de mensagens"

msgid "Delivery could not be confirmed; do not retry automatically"
msgstr "Não foi possível confirmar o envio; não repita automaticamente"

msgid "Device ID (optional)"
msgstr "ID do dispositivo (opcional)"

msgid "Device registration failed. Check the GoWA API."
msgstr "Não foi possível registrar o dispositivo. Confira a API GoWA."

msgid "Explicit opt-in, disabled by default"
msgstr "Habilitação explícita; desativado por padrão"

msgid "Gateway unavailable"
msgstr "Gateway indisponível"

msgid "GoWA API URL"
msgstr "Endereço da API GoWA"

msgid "GoWA API password"
msgstr "Senha da API GoWA"

msgid "GoWA API username"
msgstr "Usuário da API GoWA"

msgid "Message length must be 1-2000 characters"
msgstr "A mensagem deve conter de 1 a 2000 caracteres"

msgid "Private gateway URL reachable from ChurchCRM, e.g. http://whatsapp-gowa:3000"
msgstr "Endereço interno do gateway acessível pelo ChurchCRM; por exemplo http://whatsapp-gowa:3000"

msgid "QR unavailable"
msgstr "QR Code indisponível"

msgid "Recipient consent required"
msgstr "É necessário confirmar o consentimento do destinatário"

msgid "Send opted-in WhatsApp messages using a self-hosted GoWA gateway."
msgstr "Envie mensagens pelo WhatsApp para destinatários que consentiram, utilizando um gateway GoWA próprio."

msgid "Sending is disabled"
msgstr "O envio está desativado"

msgid "WhatsApp"
msgstr "WhatsApp"

msgid "WhatsApp (GoWA)"
msgstr "WhatsApp (GoWA)"
